# ── Never copy the local virtualenv (≈2 GB) or VCS history (≈51 MB) ──────────
# NOTE: `venv/` is the Python virtualenv (ignore). `env/` is PROJECT CODE
# (the Gymnasium trading environment) and must stay in the image — do not
# add it here.
venv/
.git/
.gitignore

# ── Python bytecode / build artifacts ───────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Runtime state — volume olarak gelir, image'a GOMULMEZ ───────────────────
models/
results/
logs/
# data/ ALT DIZINLERI calisma verisidir; data/*.py ise PROJE KODUDUR ve
# image'da kalmali (compose bu alt dizinleri ayri ayri named volume olarak
# baglar — data/ komple mount edilemez, .py modullerini golgeler).
# Dizinin tamami dislanir: yalnizca *.csv dislamak yetmiyordu, orn.
# data/macro/macro_data_quality.json (Faz 6 kalite bayragi) image'a sizip
# container'i hic veri cekmeden "fallback" durumuyla baslatiyordu.
data/bist/
data/macro/
data/gold/
data/fundamental/
data/predictions/
data/live_trading/
data/raw/
data/processed/
# DIKKAT: hyperparameter_optimization/ bir Python PAKETIDIR (optimizers/,
# search_spaces.py) ve app/api/routes/hyperopt.py onu import eder — dizinin
# tamami dislanirsa uygulama acilista ModuleNotFoundError verir. Sadece
# ciktilarini disla (config.py: HYPEROPT_DIR).
hyperparameter_optimization/results/
runs/

# Faz 7: kullanici calisma alanlari ve kimlik verisi asla image'a girmez.
workspaces/
data/auth/
*.db
*.db-wal
*.db-shm
.jwt_secret

# ── Secrets — passed at runtime via env_file, never in the image ─────────────
.env
.env.*
!.env.example
!.env.production.example

# ── IDE / OS noise ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Not needed to run the server ─────────────────────────────────────────────
tests/
scripts/
# Exception: admin hesabi sunucuda bu betikle acilir
# (`docker compose exec rltrading python scripts/create_admin.py`).
# Docker'da son eslesen kural kazanir, bu yuzden dislanan dizinden tek dosya
# geri alinabilir (git'ten farkli).
!scripts/create_admin.py
docs/
*.ipynb
.ipynb_checkpoints/
reviews/
*.md
!README.md

# ── Docker files themselves ──────────────────────────────────────────────────
Dockerfile
.dockerignore
docker-compose*.yml
Makefile
