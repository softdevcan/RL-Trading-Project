{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" pre",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" post",
            "timeout": 600,
            "statusMessage": "RL env bekcileri kontrol ediliyor..."
          }
        ]
      }
    ]
  }
}
