# Production environment template.
# Copy to `.env` on the server and fill in real values:
#   cp .env.production.example .env
# `.env` is gitignored and never copied into the image (.dockerignore) —
# docker-compose passes it at runtime via env_file.

# ── API metadata ─────────────────────────────────────────────────────────────
API_TITLE=RL Trading API
API_VERSION=1.0.0
API_DESCRIPTION=API for Reinforcement Learning Trading System

# ── Server ───────────────────────────────────────────────────────────────────
# HOST/PORT are also forced to 0.0.0.0:8000 by docker-compose; kept here for
# clarity and for running outside compose.
HOST=0.0.0.0
PORT=8000

# IMPORTANT: keep DEBUG off in production. It disables uvicorn --reload paths
# and verbose behavior.
DEBUG=False

# ── CORS ─────────────────────────────────────────────────────────────────────
# Values are JSON arrays (parsed by pydantic-settings).
# SECURITY: do NOT leave "*" in production. List exactly the origin(s) the
# dashboard is served from, e.g. your domain behind HTTPS:
#   CORS_ORIGINS=["https://trading.example.com"]
CORS_ORIGINS=["https://your-domain.example.com"]
CORS_CREDENTIALS=True
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# ── TCMB EVDS API key (macro data) ───────────────────────────────────────────
# Obtain from https://evds2.tcmb.gov.tr — required for macro feature fetching.
EVDS_API_KEY=your_evds_api_key_here

# ── Kimlik dogrulama / yetkilendirme (Faz 7) ─────────────────────────────────
# Sunucuda ASLA kapatmayin. False = pano ve tum API herkese acik.
AUTH_ENABLED=True

# JWT imzalama anahtari — ZORUNLU (DEBUG=False iken bos ise uygulama acilmaz).
# Uretin:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Degistirilirse tum aktif oturumlar duser (kullanicilar tekrar giris yapar).
JWT_SECRET_KEY=CHANGE_ME_uzun_rastgele_deger

# Oturum sureleri
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Cerezler — HTTPS arkasinda COOKIE_SECURE=True olmali.
COOKIE_SECURE=True
COOKIE_SAMESITE=lax
# Alt alan adlari arasinda paylasim gerekmiyorsa bos birakin.
COOKIE_DOMAIN=

# Kullanici deposu (SQLite tek dosya; ./data volume'unda kalici).
AUTH_DB_URL=sqlite:///data/auth/auth.db

# Ilk admin hesabi. Yalnizca sistemde hic kullanici yokken kullanilir.
# Alternatif: sunucuda `python scripts/create_admin.py` calistirin.
# Hesap acildiktan sonra bu iki satiri .env'den SILIN.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Brute-force korumasi
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10

# ── Kullanici calisma alanlari (hibrit izolasyon) ────────────────────────────
# Piyasa verisi (data/bist, data/macro, ...) ORTAK kalir; model, sonuc, tahmin
# ve gunluk kararlar workspaces/<kullanici_id>/ altinda ayrisir.
WORKSPACE_ISOLATION=True
WORKSPACES_DIR=workspaces
# Kullanici sistemi oncesi egitilmis modeller herkese salt-okunur gorunsun mu.
WORKSPACE_SHOW_LEGACY=True
