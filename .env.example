# API Settings
API_TITLE=RL Trading API
API_VERSION=1.0.0
API_DESCRIPTION=API for Reinforcement Learning Trading System

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Settings (comma-separated for lists)
CORS_ORIGINS=*
CORS_CREDENTIALS=True
CORS_METHODS=*
CORS_HEADERS=*

# TCMB EVDS API Key (Makro veri için - https://evds2.tcmb.gov.tr adresinden alınır)
EVDS_API_KEY=your_evds_api_key_here

# ── Faz 6: Eğitim performansı & dayanıklılık ─────────────────────────────────
# Hepsi opsiyoneldir; hiçbiri verilmezse config.py varsayılanları geçerlidir
# (= mevcut/dondurulmuş davranış). Ayrıntı: docs/development/phase-6-backend-performance.md

# Determinizm (G.5) — tüm tahmin modellerinin tek seed kaynağı.
PREDICTION_SEED=42

# Veri çekme (1.1/1.2) — paralel sembol çekme ve in-process cache tavanı.
DATA_FETCH_WORKERS=8
DATA_CACHE_MAXSIZE=64

# Feature-selection disk cache (2.4) — boş = kapalı. MI/permutation tekrarını önler.
FEATURE_SELECTION_CACHE_DIR=

# HPO kalıcı deposu (3.2) — boş = bellekte. Verilirse yarıda kesilen HPO devam eder.
# HPO_STORAGE=sqlite:///results/prediction_hyperopt/hpo.db

# --- Aşağıdakiler DAVRANIŞ DEĞİŞTİRİR: default OFF, bilinçli açılır ---
# Hızlandırırlar ama RNG tüketim sırasını kaydırdıkları için uçtan uca çıktı
# değişir (ölçüm: golden MAPE 139->177). Yalnızca "sıfırdan tam retrain" gibi
# eski model uyumluluğunun gerekmediği koşumlarda açın; açtıktan sonra golden'ı
# o donanımda yenileyin: python tests/test_prediction_regression.py --update
# Ölçülen kazanç (RTX 4060): BiLSTM preload +%56, TFT gruplanmış-VSN 4.7x.
# DL_GPU_PRELOAD=True
# TFT_FAST_VSN=True
# TRAIN_PARALLEL_SYMBOLS=2
# DL_GPU_SLOTS=1
# DL_TORCH_THREADS=0
# DL_AMP=False        # ölçüldü ve reddedildi — küçük ağlarda daha YAVAŞ
# ENSEMBLE_WARM_START=False  # A/B: yalnızca -%6.8, hedef %30'un altında
